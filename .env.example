# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mailflow?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
REQUIRE_EMAIL_VERIFICATION="false" # enable after configuring a verified sending domain
# Use the deployed https:// URL in Vercel production.
NEXTAUTH_URL="http://localhost:3000"

# App
APP_URL="http://localhost:3000"
APP_NAME="MailFlow"

# Redis / Queue
REDIS_URL="redis://localhost:6379"
QUEUE_PROVIDER="database" # database sends inline on Vercel; redis is recommended for larger campaigns

# Email provider (abstraction - see src/services/email)
EMAIL_PROVIDER="local" # local writes to .data/mailbox; resend sends real email
RESEND_API_KEY=""
SENDGRID_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
DEFAULT_SENDER_EMAIL="campaigns@yourdomain.com"
DEFAULT_SENDER_NAME="MailFlow"

# File storage
STORAGE_PROVIDER="local" # Vercel defaults to free database storage; use s3 for larger production files
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""

# Webhook verification (email provider events)
EMAIL_WEBHOOK_SECRET=""

# CAPTCHA
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Monitoring
SENTRY_DSN=""

# Encryption key for encrypted-at-rest secrets (32 bytes, base64)
ENCRYPTION_KEY=""

# Local-only seed credentials; always override outside local development
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
